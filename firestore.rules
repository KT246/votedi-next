rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // Client-side Firebase usage in this app is limited to realtime channel reads.
    // All application data writes and secure reads go through Next.js API routes
    // using the Firebase Admin SDK, which bypasses Firestore rules.
    match /realtime_channels/{channelId}/events/{eventId} {
      allow read: if true;
      allow write: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
